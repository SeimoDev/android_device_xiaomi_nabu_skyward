@@ -0,0 +1,47 @@
+//! Android's compatibility service wraps a hardware Keymaster 4.x as
+//! KeyMint v1 and SharedSecret. The secure world still performs every key
+//! operation; this only selects the binder interface used to reach it.
+
+#![cfg_attr(not(target_os = "android"), allow(dead_code))]
+
+use skyward_binder::parcel::Parcel;
+
+pub const SERVICE: &str = "android.security.compat";
+const INTERFACE: &str = "android.security.compat.IKeystoreCompatService";
+const TRUSTED_ENVIRONMENT: i32 = 1;
+pub const KEYMINT: u32 = 1;
+pub const SHARED_SECRET: u32 = 3;
+
+fn request() -> Parcel {
+    let mut call = Parcel::call(INTERFACE);
+    call.i32(TRUSTED_ENVIRONMENT);
+    call
+}
+
+#[cfg(target_os = "android")]
+pub fn device(binder: &skyward_binder::driver::Binder, code: u32) -> anyhow::Result<skyward_binder::driver::Handle<'_>> {
+    use anyhow::Context;
+    use skyward_binder::{driver::Handle, service, status};
+    let compat = service::find(binder, SERVICE)?.context("the Keymaster compatibility service is not running")?;
+    let reply = compat.transact(code, &request()).context("request the hardware Keymaster wrapper")?;
+    let mut read = reply.read();
+    status::ok(&mut read).context("request the hardware Keymaster wrapper")?;
+    let handle = read.object()?.context("the Keymaster compatibility service returned no hardware device")?;
+    Handle::hold(binder, handle)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use skyward_binder::parcel::Reader;
+
+    #[test]
+    fn requests_the_hardware_trusted_environment() {
+        let call = request();
+        let mut read = Reader::new(call.bytes());
+        assert_eq!(read.call().unwrap(), INTERFACE);
+        assert_eq!(read.i32().unwrap(), 1);
+        assert_eq!(read.here(), call.bytes().len());
+        assert_eq!((KEYMINT, SHARED_SECRET), (1, 3));
+    }
+}
