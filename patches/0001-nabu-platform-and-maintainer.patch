+use super::*;
+use crate::app::{browser_viewport, BrowserEdit};
+pub(super) const TITLE: Text = ["浏览器", "瀏覽器", "Browser"];
+
+pub(super) fn page(cx: &Ctx) -> Frame {
+    let (t,f,s,l)=(cx.t,cx.f,&cx.state.browser,cx.state.lang);
+    let mut c=super::page(cx);
+    let label=if s.url.is_empty() || s.url.starts_with("file:") { l.pick(["输入网址", "輸入網址", "Enter web address"]) } else { &s.url };
+    let address=widgets::list(&mut c,t,f,t.m.content_top,&[Row::new(label).trail(Trail::Arrow)]);
+    let mut out=hits(&address.rows,&[Action::BrowserAddress]);
+    let r=browser_viewport(t);
+    c.fill_rect(r.x,r.y,r.w,r.h,Rgba{r:255,g:255,b:255,a:255});
+    if let Some(p)=&s.frame { c.image_rgba(r,p.w,p.h,&p.rgba); }
+    if let Some(error)=&s.error {
+        let title=l.pick(["网页未能打开", "網頁無法開啟", "Couldn't open the page"]);
+        let list=widgets::list(&mut c,t,f,r.y+t.m.margin,&[Row::new(title).subtitle(error).trail(Trail::None),Row::new(l.pick(["重试", "重試", "Retry"]))]);
+        out.extend(hits(&list.rows[1..],&[Action::BrowserReload]));
+    } else if s.frame.is_none() {
+        widgets::list(&mut c,t,f,r.y+t.m.margin,&[Row::new(l.pick(["正在启动浏览器…", "正在啟動瀏覽器…", "Starting browser…"])).trail(Trail::None)]);
+    }
+    let note=if !s.download.is_empty() { &s.download } else if s.loading { l.pick(["正在加载…", "正在載入…", "Loading…"]) } else { &s.title };
+    // A separate strip keeps progress outside the webpage's touch region.
+    c.fill_rect(0.0,r.y+r.h,t.m.w as f32,t.m.dp(32.0),t.pal.bg);
+    c.text(&f.value,note,t.m.margin,r.y+r.h+t.m.dp(22.0),t.m.sub_px,t.pal.subtitle,Some(t.m.w as f32-2.0*t.m.margin));
+    let labels=[l.pick(["后退", "上一頁", "Back"]),l.pick(["前进", "下一頁", "Forward"]),l.pick(["刷新", "重新整理", "Reload"]),l.pick(["键盘", "鍵盤", "Keyboard"]),l.pick(["下载", "下載", "Downloads"])];
+    let (canvas,rects)=widgets::dock_bar(t,f,t.pal.bg,&labels);
+    let dock=Dock{canvas,hits:hits(&rects,&[Action::BrowserBack,Action::BrowserForward,Action::BrowserReload,Action::BrowserKeyboard,Action::BrowserDownloads])};
+    let c=c.crop_height(t.m.h.saturating_sub(dock.canvas.h));
+    Frame{dock:Some(dock),..Frame::new(t,c,out,l.pick(TITLE),t.m.content_top)}
+}
+
+pub(super) fn input(cx: &Ctx) -> Frame {
+    let (t,f,s,l)=(cx.t,cx.f,&cx.state.browser,cx.state.lang);
+    let address=s.edit==BrowserEdit::Address;
+    let title=l.pick(if address {["网址", "網址", "Web address"]} else {["网页输入", "網頁輸入", "Page input"]});
+    let mut c=super::page(cx);
+    let mut out=Vec::new();
+    let y=widgets::section_first(&mut c,t,f,t.m.content_top,title);
+    let text=if matches!(s.edit,BrowserEdit::Field{secret:true}) { "•".repeat(s.input.chars().count()) } else { s.input.clone() };
+    let(y,caret)=widgets::text_field(&mut c,t,f,y,&text);
+    let list=widgets::list(&mut c,t,f,y+t.m.card_gap,&[Row::new(l.pick(["清空", "清除", "Clear"]))]);
+    out.extend(hits(&list.rows,&[Action::BrowserClear]));
+    keyboard_hits(&mut c,t,f,cx.state,l.pick(if address {["打开", "開啟", "Go"]} else {["完成", "完成", "Done"]}),&mut out);
+    Frame{caret:Some(caret),..Frame::new(t,c,out,title,t.m.content_top)}
+}
