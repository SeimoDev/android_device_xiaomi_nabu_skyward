@@ -0,0 +1,283 @@
+//! Editing proxy and DNS preferences before applying them together.
+
+use super::*;
+use skyward_net::network::{self, Invalid, ProxyKind, Settings as NetworkSettings};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum NetworkField {
+    ProxyServer,
+    ProxyPort,
+    ProxyUsername,
+    ProxyPassword,
+    DnsPrimary,
+    DnsSecondary,
+}
+
+impl NetworkField {
+    pub fn title(self, l: Lang) -> &'static str {
+        l.pick(match self {
+            Self::ProxyServer => ["代理服务器", "代理伺服器", "Proxy server"],
+            Self::ProxyPort => ["端口", "連接埠", "Port"],
+            Self::ProxyUsername => ["用户名", "使用者名稱", "Username"],
+            Self::ProxyPassword => ["代理密码", "代理密碼", "Proxy password"],
+            Self::DnsPrimary => ["首选 DNS", "慣用 DNS", "Primary DNS"],
+            Self::DnsSecondary => ["备用 DNS", "其他 DNS", "Secondary DNS"],
+        })
+    }
+}
+
+#[derive(Clone, PartialEq, Eq)]
+pub struct NetworkDraft {
+    pub settings: NetworkSettings,
+    pub field: Option<NetworkField>,
+    pub text: String,
+}
+
+impl std::fmt::Debug for NetworkDraft {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("NetworkDraft").field("settings", &self.settings)
+            .field("field", &self.field).field("text_characters", &self.text.chars().count()).finish()
+    }
+}
+
+pub fn network_error(l: Lang, error: Invalid) -> &'static str {
+    l.pick(match error {
+        Invalid::ProxyServer => ["请输入代理服务器的 IP 地址或域名", "請輸入代理伺服器的 IP 位址或網域名稱", "Enter a proxy server IP address or hostname"],
+        Invalid::ProxyPort => ["端口必须为 1 到 65535", "連接埠必須為 1 到 65535", "Enter a port from 1 to 65535"],
+        Invalid::ProxyUsername => ["请检查代理用户名和密码", "請檢查代理使用者名稱和密碼", "Check the proxy username and password"],
+        Invalid::DnsPrimary => ["请输入有效的首选 DNS IP 地址", "請輸入有效的慣用 DNS IP 位址", "Enter a valid primary DNS IP address"],
+        Invalid::DnsSecondary => ["请输入有效的备用 DNS IP 地址，或留空", "請輸入有效的其他 DNS IP 位址，或留白", "Enter a valid secondary DNS IP address, or leave it empty"],
+    })
+}
+
+impl App {
+    pub(super) fn network_draft(&mut self) {
+        self.state.network_draft = Some(NetworkDraft { settings: self.state.network.clone(), field: None, text: String::new() });
+    }
+
+    pub(super) fn edit_network(&mut self, field: NetworkField) {
+        let draft = self.state.network_draft.as_mut().expect("network preferences page");
+        draft.field = Some(field);
+        draft.text = match field {
+            NetworkField::ProxyServer => draft.settings.proxy.server.clone(),
+            NetworkField::ProxyPort => draft.settings.proxy.port.to_string(),
+            NetworkField::ProxyUsername => draft.settings.proxy.username.clone(),
+            NetworkField::ProxyPassword => draft.settings.proxy.password.clone(),
+            NetworkField::DnsPrimary => draft.settings.dns.primary.clone(),
+            NetworkField::DnsSecondary => draft.settings.dns.secondary.clone(),
+        };
+        self.state.show_password = false;
+        self.state.layer = match field {
+            NetworkField::ProxyPort | NetworkField::DnsPrimary | NetworkField::DnsSecondary => Layer::Digits,
+            _ => Layer::Letters,
+        };
+        self.open(Screen::NetworkInput);
+    }
+
+    pub(super) fn finish_network_input(&mut self, now: u64) -> Vec<Effect> {
+        let draft = self.state.network_draft.as_mut().expect("network preferences page");
+        let field = draft.field.expect("network input field");
+        let text = draft.text.trim().to_string();
+        let invalid = match field {
+            NetworkField::ProxyServer => {
+                let mut check = draft.settings.clone();
+                check.proxy.server = text.clone();
+                match check.validate() {
+                    Err(Invalid::ProxyServer) => Some(Invalid::ProxyServer),
+                    _ => { draft.settings.proxy.server = text; None }
+                }
+            }
+            NetworkField::ProxyPort => match text.parse::<u16>().ok().filter(|&port| port > 0) {
+                Some(port) => { draft.settings.proxy.port = port; None }
+                None => Some(Invalid::ProxyPort),
+            },
+            NetworkField::ProxyUsername => { draft.settings.proxy.username = draft.text.clone(); None }
+            NetworkField::ProxyPassword => { draft.settings.proxy.password = draft.text.clone(); None }
+            NetworkField::DnsPrimary | NetworkField::DnsSecondary => {
+                if field == NetworkField::DnsSecondary && text.is_empty() {
+                    draft.settings.dns.secondary.clear();
+                    None
+                } else {
+                    match network::parse_dns(&text) {
+                        Ok(ip) => {
+                            if field == NetworkField::DnsPrimary { draft.settings.dns.primary = ip.to_string(); }
+                            else { draft.settings.dns.secondary = ip.to_string(); }
+                            None
+                        }
+                        Err(_) => Some(if field == NetworkField::DnsPrimary { Invalid::DnsPrimary } else { Invalid::DnsSecondary }),
+                    }
+                }
+            }
+        };
+        if let Some(error) = invalid {
+            self.say(network_error(self.state.lang, error), now);
+            return Vec::new();
+        }
+        self.back(now)
+    }
+
+    pub(super) fn save_network(&mut self, now: u64) -> Vec<Effect> {
+        let settings = self.state.network_draft.as_ref().expect("network preferences page").settings.clone();
+        if let Err(error) = settings.validate() {
+            self.say(network_error(self.state.lang, error), now);
+            return Vec::new();
+        }
+        let changed = self.state.network != settings;
+        self.state.network = settings.clone();
+        let mut effects = self.back(now);
+        if changed { effects.push(Effect::NetworkSettings(settings)); }
+        effects
+    }
+
+    pub(super) fn choose_proxy(&mut self, kind: ProxyKind) {
+        let proxy = &mut self.state.network_draft.as_mut().expect("proxy page").settings.proxy;
+        if proxy.kind != kind {
+            if matches!(proxy.port, 8080 | 1080) {
+                proxy.port = if kind == ProxyKind::Socks5 { 1080 } else { 8080 };
+            }
+            proxy.kind = kind;
+            self.refresh();
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::app::testing::*;
+
+    fn open() -> App {
+        let mut app = App::new(Screen::Wlan, W, H, PPD);
+        app.state.wlan = Some(Wlan::default());
+        app.act(Action::Open(Screen::WlanAdvanced), 0);
+        app
+    }
+
+    fn replace(app: &mut App, text: &str) {
+        while !app.state.network_draft.as_ref().unwrap().text.is_empty() {
+            app.act(Action::Type(Cap::Backspace), 0);
+        }
+        for ch in text.chars() {
+            app.act(Action::Type(Cap::Char(ch)), 0);
+        }
+    }
+
+    #[test]
+    fn manual_dns_is_validated_saved_and_restored_and_back_discards_edits() {
+        let (f, i) = (fonts(), info());
+        let mut app = open();
+        assert!(app.frame(&f, &i).hits.iter().any(|hit| hit.action == Action::Open(Screen::WlanDns)));
+        app.act(Action::Open(Screen::WlanDns), 0);
+        app.act(Action::ManualDns(true), 0);
+        assert!(app.act(Action::SaveNetwork, 0).is_empty());
+        assert_eq!(app.screen(), Screen::WlanDns);
+        assert!(!app.state.network.dns.manual);
+        app.act(Action::EditNetwork(NetworkField::DnsPrimary), 0);
+        replace(&mut app, "not-an-ip");
+        app.act(Action::Type(Cap::Enter), 0);
+        assert_eq!(app.screen(), Screen::NetworkInput);
+        replace(&mut app, "1.1.1.1");
+        app.act(Action::Type(Cap::Enter), 0);
+        assert_eq!(app.screen(), Screen::WlanDns);
+        assert_eq!(app.state.network_draft.as_ref().unwrap().settings.dns.primary, "1.1.1.1");
+        app.act(Action::EditNetwork(NetworkField::DnsSecondary), 0);
+        replace(&mut app, "2606:4700:4700::1111");
+        app.act(Action::Type(Cap::Enter), 0);
+        let effects = app.act(Action::SaveNetwork, 0);
+        assert_eq!(effects, vec![Effect::NetworkSettings(app.state.network.clone())]);
+        let saved = Settings::read(&app.settings().text()).unwrap();
+        let mut restored = State::default();
+        saved.apply(&mut restored);
+        assert_eq!(restored.network, app.state.network);
+        app.act(Action::Open(Screen::WlanDns), 0);
+        app.act(Action::ManualDns(false), 0);
+        app.act(Action::Back, 0);
+        assert!(app.state.network.dns.manual, "back leaves the saved choice in place");
+        app.act(Action::Open(Screen::WlanDns), 0);
+        app.act(Action::ManualDns(false), 0);
+        app.act(Action::SaveNetwork, 0);
+        assert!(!app.state.network.dns.manual);
+        assert_eq!(app.state.network.dns.primary, "1.1.1.1", "manual addresses remain available when toggled back");
+    }
+
+    #[test]
+    fn proxy_port_and_credentials_are_edited_before_applying() {
+        let mut app = open();
+        app.act(Action::Open(Screen::WlanProxy), 0);
+        app.act(Action::ChooseProxy(ProxyKind::Socks5), 0);
+        assert_eq!(app.state.network_draft.as_ref().unwrap().settings.proxy.port, 1080);
+        app.act(Action::EditNetwork(NetworkField::ProxyServer), 0);
+        replace(&mut app, "http://proxy.example");
+        app.act(Action::Type(Cap::Enter), 0);
+        assert_eq!(app.screen(), Screen::NetworkInput);
+        replace(&mut app, "proxy.example");
+        app.act(Action::Type(Cap::Enter), 0);
+        app.act(Action::EditNetwork(NetworkField::ProxyPort), 0);
+        replace(&mut app, "65536");
+        app.act(Action::Type(Cap::Enter), 0);
+        assert_eq!(app.screen(), Screen::NetworkInput);
+        replace(&mut app, "1080");
+        app.act(Action::Type(Cap::Enter), 0);
+        app.act(Action::EditNetwork(NetworkField::ProxyUsername), 0);
+        replace(&mut app, "user");
+        app.act(Action::Type(Cap::Enter), 0);
+        app.act(Action::EditNetwork(NetworkField::ProxyPassword), 0);
+        replace(&mut app, "private-password");
+        assert!(!format!("{:?}", app.state.network_draft).contains("private-password"));
+        assert!(!app.state.show_password);
+        app.act(Action::Type(Cap::Enter), 0);
+        let effects = app.act(Action::SaveNetwork, 0);
+        assert_eq!(effects, vec![Effect::NetworkSettings(app.state.network.clone())]);
+        assert!(!format!("{effects:?}").contains("private-password"));
+        assert_eq!(app.state.network.proxy.kind, ProxyKind::Socks5);
+        app.act(Action::Open(Screen::WlanProxy), 0);
+        app.act(Action::ChooseProxy(ProxyKind::None), 0);
+        app.act(Action::SaveNetwork, 0);
+        assert_eq!(app.state.network.proxy.kind, ProxyKind::None);
+        assert_eq!(app.state.network.proxy.server, "proxy.example");
+    }
+
+    #[test]
+    fn network_pages_fit_nabu_and_render_in_both_themes() {
+        let (f, mut i) = (fonts(), info());
+        i.model = "Xiaomi Pad 5".into();
+        i.codename = "nabu".into();
+        i.panel = Some((1600, 2560));
+        let output = std::env::var_os("SKYWARD_NETWORK_PREVIEWS").map(std::path::PathBuf::from);
+        if let Some(path) = &output { std::fs::create_dir_all(path).unwrap(); }
+        for dark in [true, false] {
+            for (name, screen, field) in [
+                ("wifi", Screen::Wlan, None),
+                ("advanced", Screen::WlanAdvanced, None),
+                ("proxy", Screen::WlanProxy, None),
+                ("proxy-long", Screen::WlanProxy, None),
+                ("dns", Screen::WlanDns, None),
+                ("server", Screen::NetworkInput, Some(NetworkField::ProxyServer)),
+                ("dns-input", Screen::NetworkInput, Some(NetworkField::DnsPrimary)),
+                ("password", Screen::NetworkInput, Some(NetworkField::ProxyPassword)),
+            ] {
+                let mut app = App::new(screen, 1600, 2560, 2.25);
+                app.state.dark = dark;
+                app.state.wlan = Some(Wlan::default());
+                app.state.network.proxy = network::Proxy { kind: ProxyKind::Socks5, server: "proxy.example.com".into(), port: 1080,
+                    username: "user".into(), password: "private-password".into() };
+                app.state.network.dns = network::Dns { manual: true, primary: "1.1.1.1".into(), secondary: "2606:4700:4700::1111".into() };
+                if name == "proxy-long" {
+                    app.state.network.proxy.server = format!("{}.{}.{}.example.com", "a".repeat(63), "b".repeat(63), "c".repeat(63));
+                    app.state.network.proxy.username = "u".repeat(255);
+                }
+                app.network_draft();
+                if let Some(field) = field {
+                    app.edit_network(field);
+                }
+                let frame = app.whole_frame(&f, &i);
+                assert!(frame.hits.iter().all(|hit| hit.rect.x >= 0.0 && hit.rect.x + hit.rect.w <= 1601.0));
+                let mut image = Canvas::new(1600, 2560);
+                app.compose(&mut image, &f, &i, "12:00", 1000);
+                if let Some(path) = &output {
+                    image.write_png(std::fs::File::create(path.join(format!("{name}-{}.png", if dark { "dark" } else { "light" }))).unwrap()).unwrap();
+                }
+            }
+        }
+    }
+}
