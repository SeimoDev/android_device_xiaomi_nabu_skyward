diff --git a/crates/skyward-programs/tests/nabu.rs b/crates/skyward-programs/tests/nabu.rs
new file mode 100644
index 0000000..ad9bddd
--- /dev/null
+++ b/crates/skyward-programs/tests/nabu.rs
@@ -0,0 +1,46 @@
+use skyward_programs::description::Kind;
+use skyward_programs::phone::{Partition, Phone, PARTITIONS};
+use skyward_programs::secure::{self, KEYMASTER_COMPAT};
+use std::collections::HashMap;
+use std::path::Path;
+
+#[test]
+fn nabu_hyperos4_uses_its_hardware_keymaster_and_hidl_supplicant() {
+    let root = std::env::var_os("SKYWARD_NABU_TEST_ROM").map(std::path::PathBuf::from)
+        .unwrap_or_else(|| Path::new(env!("CARGO_MANIFEST_DIR")).join("tests/nabu"));
+    let partitions = PARTITIONS.iter().map(|name| Partition {
+        name: name.to_string(),
+        mounted: match *name { "vendor" | "odm" => format!("/{name}"), "system" => "/mnt/system/system".into(), _ => format!("/mnt/{name}") }.into(),
+        at: if *name == "system" { root.join("system/system") } else { root.join(name) },
+    }).collect();
+    let phone = Phone::read(partitions, HashMap::new(), None).unwrap();
+    let steps = secure::steps(&phone).unwrap();
+    let programs = secure::programs(&steps);
+    let paths: Vec<_> = programs.iter().map(|p| p.service.path.as_str()).collect();
+    assert_eq!(paths, [
+        "/vendor/bin/qseecomd",
+        "/vendor/bin/ssgtzd",
+        "/mnt/system/system/bin/hwservicemanager",
+        "/vendor/bin/hw/android.hardware.keymaster@4.1-service-qti",
+        KEYMASTER_COMPAT,
+        "/vendor/bin/hw/android.hardware.gatekeeper@1.0-service-qti",
+        "/vendor/bin/hw/android.hardware.boot-service.nabu",
+    ]);
+    assert_eq!(programs[3].service.ready_hardware_service.as_deref(), Some("android.hardware.keymaster@4.1::IKeymasterDevice/default"));
+    assert_eq!(programs[4].service.ready_property.as_deref(), Some("skyward.keymaster.compat.ready"));
+    assert_eq!(programs[5].service.user.as_deref(), Some("system"));
+    assert!(phone.services.iter().any(|s| s.described.kind == Kind::Hidl
+        && s.described.name() == "android.hardware.wifi.supplicant@1.3::ISupplicant/default"));
+    assert!(phone.services.iter().any(|s| s.described.kind == Kind::Hidl
+        && s.described.name() == "vendor.qti.hardware.wifi.supplicant@2.2::ISupplicantVendor/default"));
+}
+
+#[test]
+fn system_as_root_services_are_read_below_the_filesystem_root() {
+    let root = tempfile::tempdir().unwrap();
+    std::fs::create_dir_all(root.path().join("system/etc/init")).unwrap();
+    let partition = Partition::mounted("system", root.path());
+    assert_eq!(partition.at, root.path().join("system"));
+    assert_eq!(partition.mounted, partition.at);
+    assert_eq!(Partition::mounted("vendor", root.path()).at, root.path());
+}
