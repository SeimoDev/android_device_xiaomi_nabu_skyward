@@ -0,0 +1,42 @@
+use anyhow::Result;
+use skyward_bootimg::Ramdisk;
+use sha2::{Digest, Sha256};
+use std::io::{Cursor, Write};
+
+const SCRIPT: &str = r#"#!/system/bin/sh
+OUTFD="$2"
+ui_print() { echo "ui_print $*" >&$OUTFD; echo "ui_print" >&$OUTFD; }
+ui_print "Install Skyward to the current boot slot"
+ui_print "The original boot image is backed up before writing."
+ln -sf /system/bin/recovery /tmp/skyward-install-cli || exit 1
+/tmp/skyward-install-cli install-boot --package "$3" >/tmp/skyward-boot-install.log 2>&1
+result=$?
+while IFS= read -r line; do ui_print "$line"; done </tmp/skyward-boot-install.log
+exit "$result"
+"#;
+
+pub fn package(ramdisk: &[u8], kernel: &[u8]) -> Result<Vec<u8>> {
+    let mut rd = Ramdisk::decode(ramdisk)?;
+    let mut files = String::new();
+    for entry in &mut rd.entries {
+        if entry.mode & 0o170000 == 0o100000 && entry.data.len() >= 65536 && (entry.name.starts_with("system/") || entry.name.starts_with("skyward/")) {
+            let sum: String = Sha256::digest(&entry.data).iter().map(|b| format!("{b:02x}")).collect();
+            files.push_str(&format!("{}\t{}\t{sum}\n", entry.name, entry.data.len()));
+            entry.data.clear();
+        }
+    }
+    let payload = rd.encode_like(ramdisk)?;
+    let mut zip = zip::ZipWriter::new(Cursor::new(Vec::new()));
+    let options = zip::write::SimpleFileOptions::default().compression_method(zip::CompressionMethod::Stored)
+        .last_modified_time(zip::DateTime::default());
+    for (name, mode, data) in [
+        ("META-INF/com/google/android/update-binary", 0o755, SCRIPT.as_bytes()),
+        ("ramdisk.cpio.gz", 0o644, payload.as_slice()),
+        ("ramdisk.files", 0o644, files.as_bytes()),
+        ("kernel.sha256", 0o644, &Sha256::digest(kernel)[..]),
+    ] {
+        zip.start_file(name, options.unix_permissions(mode))?;
+        zip.write_all(data)?;
+    }
+    Ok(zip.finish()?.into_inner())
+}
