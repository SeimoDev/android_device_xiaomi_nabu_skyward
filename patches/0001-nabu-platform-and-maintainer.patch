diff --git a/crates/skyward-ui/src/app/browser.rs b/crates/skyward-ui/src/app/browser.rs
new file mode 100644
index 0000000..c774103
--- /dev/null
+++ b/crates/skyward-ui/src/app/browser.rs
@@ -0,0 +1,112 @@
+//! Browser navigation, text entry and the webpage's native input bridge.
+use super::*;
+use serde::Serialize;
+use std::sync::Arc;
+
+#[derive(Clone, Debug, PartialEq, Serialize)]
+#[serde(tag = "cmd", rename_all = "snake_case")]
+pub enum BrowserCommand {
+    Open, Close, Back, Forward, Reload, Focus,
+    Navigate { url: String },
+    Text { text: String },
+    Touch { phase: u8, x: f32, y: f32 },
+}
+
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub enum BrowserEdit { #[default] Address, Field { secret: bool } }
+
+#[derive(Clone, PartialEq, Eq)]
+pub struct BrowserPixels { pub w: u32, pub h: u32, pub rgba: Vec<u8> }
+impl std::fmt::Debug for BrowserPixels {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result { f.debug_tuple("BrowserPixels").field(&self.w).field(&self.h).finish() }
+}
+
+#[derive(Clone, Default, PartialEq)]
+pub struct BrowserState {
+    pub enabled: bool, pub running: bool, pub loading: bool,
+    pub url: String, pub title: String, pub error: Option<String>,
+    pub back: bool, pub forward: bool, pub download: String,
+    pub frame: Option<Arc<BrowserPixels>>,
+    pub edit: BrowserEdit, pub input: String,
+    finger: Option<(f32, f32)>,
+}
+impl std::fmt::Debug for BrowserState {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("BrowserState").field("running", &self.running).field("loading", &self.loading).field("error", &self.error).finish()
+    }
+}
+
+/// WebKit receives CSS pixels; the native page reserves its bars in panel pixels.
+pub fn browser_viewport(t: &Theme) -> Rect {
+    let y = t.m.content_top + t.m.row_h + t.m.dp(10.0);
+    Rect::new(0.0, y, t.m.w as f32, (t.m.h as f32 - y - t.m.dp(118.0)).max(1.0))
+}
+
+pub fn browser_url(text: &str) -> Option<String> {
+    let text = text.trim();
+    if text.is_empty() || text.len() > 8192 || text.chars().any(|c| c.is_control() || c.is_whitespace()) { return None; }
+    let url = if text.starts_with("https://") || text.starts_with("http://") { text.to_owned() }
+        else if text.contains("://") || text.starts_with("javascript:") || text.starts_with("data:") || text.starts_with("file:") { return None; }
+        else { format!("https://{text}") };
+    let host = url.split_once("://")?.1.split('/').next()?;
+    if host.is_empty() { None } else { Some(url) }
+}
+
+impl App {
+    pub fn browser_changed(&mut self) { self.refresh(); }
+    pub fn browser_field(&mut self, text: String, secret: bool) {
+        if self.screen() == Screen::Browser { self.edit_browser(BrowserEdit::Field { secret }, text); }
+    }
+    pub(super) fn edit_browser(&mut self, edit: BrowserEdit, text: String) {
+        self.state.browser.input = if edit == BrowserEdit::Address { self.state.browser.url.clone().strip_prefix("file:").map_or_else(|| self.state.browser.url.clone(), |_| String::new()) } else { text };
+        self.state.browser.edit = edit;
+        self.state.layer = Layer::Letters;
+        self.open(Screen::BrowserInput);
+    }
+    pub(super) fn submit_browser(&mut self, now: u64) -> Vec<Effect> {
+        let command = match self.state.browser.edit {
+            BrowserEdit::Address => match browser_url(&self.state.browser.input) {
+                Some(url) => BrowserCommand::Navigate { url },
+                None => { self.say(self.state.lang.pick(["请输入 HTTP 或 HTTPS 网址", "請輸入 HTTP 或 HTTPS 網址", "Enter an HTTP or HTTPS address"]), now); return Vec::new(); }
+            },
+            BrowserEdit::Field { .. } => BrowserCommand::Text { text: std::mem::take(&mut self.state.browser.input) },
+        };
+        let mut effects = self.back(now);
+        effects.push(Effect::Browser(command));
+        effects
+    }
+    pub(super) fn browser_touch(&mut self, ev: Touch) -> Option<Vec<Effect>> {
+        if self.screen() != Screen::Browser { return None; }
+        if self.state.browser.error.is_some() { return None; }
+        let rect = browser_viewport(&self.theme());
+        let size = self.state.browser.frame.as_ref().map(|p| (p.w as f32, p.h as f32));
+        let size = size?;
+        let (phase, x, y) = match ev {
+            Touch::Down(x,y) if rect.contains(x,y) => { self.state.browser.finger = Some((x,y)); (0,x,y) },
+            Touch::Move(x,y) if self.state.browser.finger.is_some() => { self.state.browser.finger = Some((x,y)); (1,x,y) },
+            Touch::Up => { let (x,y) = self.state.browser.finger.take()?; (2,x,y) },
+            _ => return None,
+        };
+        Some(vec![Effect::Browser(BrowserCommand::Touch { phase, x: (x-rect.x)*size.0/rect.w, y: (y-rect.y)*size.1/rect.h })])
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test] fn addresses_allow_web_navigation() {
+        assert_eq!(browser_url(" example.com/a?b=1 ").as_deref(), Some("https://example.com/a?b=1"));
+        assert_eq!(browser_url("http://192.0.2.1/").as_deref(), Some("http://192.0.2.1/"));
+        for url in ["", "file:///etc/passwd", "javascript:alert(1)", "data:text/html,hi", "https://", "two words"] { assert_eq!(browser_url(url), None); }
+    }
+    #[test] fn webpage_drag_keeps_its_coordinates_through_release() {
+        let mut app=App::new(Screen::Browser,1600,2560,2.25);
+        app.state.browser.frame=Some(Arc::new(BrowserPixels{w:800,h:1000,rgba:vec![]}));
+        let r=browser_viewport(&app.theme());
+        assert!(app.browser_touch(Touch::Down(800.0,r.y+100.0)).is_some());
+        app.browser_touch(Touch::Move(900.0,r.y+200.0));
+        let fx=app.browser_touch(Touch::Up).unwrap();
+        assert!(matches!(fx[0], Effect::Browser(BrowserCommand::Touch{phase:2,x,..}) if x==450.0));
+        assert!(app.browser_touch(Touch::Up).is_none());
+    }
+}
