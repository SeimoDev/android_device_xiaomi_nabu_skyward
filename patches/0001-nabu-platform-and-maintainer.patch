@@ -0,0 +1,159 @@
+use super::*;
+use skyward_net::network::ProxyKind;
+
+pub(super) const ADVANCED: Text = ["高级网络设置", "進階網路設定", "Advanced network settings"];
+const PROXY: Text = ["代理", "代理伺服器", "Proxy"];
+const AUTO: Text = ["自动获取", "自動取得", "Automatic"];
+const MANUAL: Text = ["手动", "手動", "Manual"];
+const SAVE: Text = ["保存", "儲存", "Save"];
+
+fn preview(c: &Canvas, t: &Theme, f: &Fonts, text: &str) -> String {
+    let m = &t.m;
+    let max = (m.w as f32 - m.margin * 2.0 - m.inner * 2.0) * 0.45;
+    if c.text_width(&f.value, text, m.sub_px) <= max { return text.to_string(); }
+    let limit = max - c.text_width(&f.value, "…", m.sub_px);
+    let (mut width, mut out) = (0.0, String::new());
+    for ch in text.chars() {
+        let advance = c.text_width(&f.value, &ch.to_string(), m.sub_px);
+        if width + advance > limit { break; }
+        width += advance;
+        out.push(ch);
+    }
+    out.push('…');
+    out
+}
+
+fn proxy_name(l: Lang, kind: ProxyKind) -> &'static str {
+    match kind {
+        ProxyKind::None => l.pick(["无", "無", "None"]),
+        ProxyKind::Http => "HTTP CONNECT",
+        ProxyKind::Socks5 => "SOCKS5",
+    }
+}
+
+fn save_dock(t: &Theme, f: &Fonts, l: Lang) -> Dock {
+    let (canvas, rects) = widgets::dock_bar(t, f, files::page(t), &[l.pick(SAVE)]);
+    Dock { canvas, hits: hits(&rects, &[Action::SaveNetwork]) }
+}
+
+pub(super) fn advanced(cx: &Ctx) -> Frame {
+    let (t, f, s, l) = (cx.t, cx.f, cx.state, cx.state.lang);
+    let mut c = long_page(cx);
+    let dns_value = preview(&c, t, f, if s.network.dns.manual { &s.network.dns.primary } else { l.pick(AUTO) });
+    let rows = [
+        Row::new(l.pick(PROXY)).trail(Trail::Value(proxy_name(l, s.network.proxy.kind))),
+        Row::new("DNS").trail(Trail::Value(&dns_value)),
+    ];
+    let list = widgets::list(&mut c, t, f, t.m.content_top, &rows);
+    let out = hits(&list.rows, &[Action::Open(Screen::WlanProxy), Action::Open(Screen::WlanDns)]);
+    let y = widgets::footnote(&mut c, t, f, list.bottom,
+        l.pick(["用于 Recovery 的联网检测和下载，保存后对新请求生效。",
+            "用於 Recovery 的連線檢查和下載，儲存後對新要求生效。",
+            "Used for Recovery connectivity checks and downloads. Saved changes apply to new requests."]));
+    Frame::new(t, fit(c, t, y), out, l.pick(ADVANCED), t.m.content_top)
+}
+
+pub(super) fn proxy(cx: &Ctx) -> Frame {
+    let (t, f, s, l) = (cx.t, cx.f, cx.state, cx.state.lang);
+    let proxy = &s.network_draft.as_ref().expect("proxy preferences").settings.proxy;
+    let mut c = long_page(cx);
+    let kinds = [ProxyKind::None, ProxyKind::Http, ProxyKind::Socks5];
+    let rows = kinds.map(|kind| Row::new(proxy_name(l, kind)).trail(Trail::Check(proxy.kind == kind)));
+    let list = widgets::list(&mut c, t, f, t.m.content_top, &rows);
+    let mut out = hits(&list.rows, &kinds.map(Action::ChooseProxy));
+    let mut y = list.bottom;
+    if proxy.kind != ProxyKind::None {
+        let fields = [NetworkField::ProxyServer, NetworkField::ProxyPort, NetworkField::ProxyUsername, NetworkField::ProxyPassword];
+        let values = [
+            if proxy.server.is_empty() { l.pick(["未设置", "尚未設定", "Not set"]).into() } else { proxy.server.clone() },
+            proxy.port.to_string(),
+            if proxy.username.is_empty() { l.pick(["可选", "選填", "Optional"]).into() } else { proxy.username.clone() },
+            if proxy.password.is_empty() { l.pick(["可选", "選填", "Optional"]).into() } else { "•".repeat(proxy.password.chars().count().min(12)) },
+        ];
+        let values: Vec<_> = values.iter().map(|value| preview(&c, t, f, value)).collect();
+        let rows: Vec<Row> = fields.iter().zip(&values).map(|(field, value)| Row::new(field.title(l)).trail(Trail::Value(value))).collect();
+        let list = widgets::list(&mut c, t, f, y + t.m.card_gap, &rows);
+        out.extend(hits(&list.rows, &fields.map(Action::EditNetwork)));
+        y = widgets::footnote(&mut c, t, f, list.bottom,
+            l.pick(["用户名和密码仅在代理服务器要求认证时填写。", "代理伺服器需要驗證時才填寫使用者名稱和密碼。",
+                "Enter a username and password when your proxy requires authentication."]));
+    }
+    Frame { dock: Some(save_dock(t, f, l)), ..Frame::new(t, fit(c, t, y), out, l.pick(PROXY), t.m.content_top) }
+}
+
+pub(super) fn dns(cx: &Ctx) -> Frame {
+    let (t, f, s, l) = (cx.t, cx.f, cx.state, cx.state.lang);
+    let dns = &s.network_draft.as_ref().expect("DNS preferences").settings.dns;
+    let mut c = long_page(cx);
+    let rows = [Row::new(l.pick(AUTO)).trail(Trail::Check(!dns.manual)), Row::new(l.pick(MANUAL)).trail(Trail::Check(dns.manual))];
+    let list = widgets::list(&mut c, t, f, t.m.content_top, &rows);
+    let mut out = hits(&list.rows, &[Action::ManualDns(false), Action::ManualDns(true)]);
+    let mut y = list.bottom;
+    if dns.manual {
+        let fields = [NetworkField::DnsPrimary, NetworkField::DnsSecondary];
+        let values = [
+            if dns.primary.is_empty() { l.pick(["未设置", "尚未設定", "Not set"]).into() } else { dns.primary.clone() },
+            if dns.secondary.is_empty() { l.pick(["可选", "選填", "Optional"]).into() } else { dns.secondary.clone() },
+        ];
+        let values: Vec<_> = values.iter().map(|value| preview(&c, t, f, value)).collect();
+        let rows: Vec<Row> = fields.iter().zip(&values).map(|(field, value)| Row::new(field.title(l)).trail(Trail::Value(value))).collect();
+        let list = widgets::list(&mut c, t, f, y + t.m.card_gap, &rows);
+        out.extend(hits(&list.rows, &fields.map(Action::EditNetwork)));
+        y = list.bottom;
+    }
+    y = widgets::footnote(&mut c, t, f, y, l.pick([
+        "自动获取使用当前网络分配的 DNS。手动设置支持 IPv4 和 IPv6 服务器地址。",
+        "自動取得會使用目前網路分配的 DNS。手動設定支援 IPv4 和 IPv6 伺服器位址。",
+        "Automatic uses DNS servers supplied by the network. Manual accepts IPv4 and IPv6 server addresses."]));
+    Frame { dock: Some(save_dock(t, f, l)), ..Frame::new(t, fit(c, t, y), out, "DNS", t.m.content_top) }
+}
+
+pub(super) fn input(cx: &Ctx) -> Frame {
+    let (t, f, s, l) = (cx.t, cx.f, cx.state, cx.state.lang);
+    let draft = s.network_draft.as_ref().expect("network input");
+    let field = draft.field.expect("network field");
+    let mut c = page(cx);
+    let mut out = Vec::new();
+    let y = widgets::section_first(&mut c, t, f, t.m.content_top, field.title(l));
+    let password = field == NetworkField::ProxyPassword;
+    let shown = if password && !s.show_password { "•".repeat(draft.text.chars().count()) } else { draft.text.clone() };
+    let (mut y, caret) = widgets::text_field(&mut c, t, f, y, &shown);
+    if password {
+        let list = widgets::list(&mut c, t, f, y + t.m.card_gap, &[Row::new(l.pick(SHOW_PASSWORD)).trail(Trail::Switch(s.show_password))]);
+        out.extend(hits(&list.rows, &[Action::Toggle(Switch::ShowPassword)]));
+        y = list.bottom;
+    }
+    let hint = l.pick(match field {
+        NetworkField::ProxyServer => ["例如 192.168.1.2 或 proxy.example.com", "例如 192.168.1.2 或 proxy.example.com", "For example, 192.168.1.2 or proxy.example.com"],
+        NetworkField::ProxyPort => ["有效范围为 1 到 65535", "有效範圍為 1 到 65535", "Valid ports range from 1 to 65535"],
+        NetworkField::ProxyUsername | NetworkField::ProxyPassword => ["代理服务器要求认证时填写", "代理伺服器需要驗證時填寫", "Use when the proxy requires authentication"],
+        NetworkField::DnsPrimary => ["输入 IPv4 或 IPv6 地址，例如 1.1.1.1", "輸入 IPv4 或 IPv6 位址，例如 1.1.1.1", "Enter an IPv4 or IPv6 address, such as 1.1.1.1"],
+        NetworkField::DnsSecondary => ["可留空；首选服务器无法响应时使用", "可以留白；慣用伺服器無回應時使用", "Optional; used when the primary server cannot answer"],
+    });
+    widgets::footnote(&mut c, t, f, y, hint);
+    keyboard_hits(&mut c, t, f, s, l.pick(["完成", "完成", "Done"]), &mut out);
+    Frame { caret: Some(caret), ..Frame::new(t, c, out, field.title(l), t.m.content_top) }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::app::App;
+
+    #[test]
+    fn long_network_values_keep_their_labels_room() {
+        let fonts = crate::font::bundled();
+        let app = App::new(Screen::WlanProxy, 1600, 2560, 2.25);
+        let theme = app.theme();
+        let canvas = Canvas::new(1600, 2560);
+        let host = format!("{}.{}.{}.example.com", "a".repeat(63), "b".repeat(63), "c".repeat(63));
+        let username = "u".repeat(255);
+        for original in [host.as_str(), username.as_str(), "2606:4700:4700:0000:0000:0000:0000:1111"] {
+            let shown = preview(&canvas, &theme, &fonts, original);
+            let max = (theme.m.w as f32 - theme.m.margin * 2.0 - theme.m.inner * 2.0) * 0.45;
+            assert!(canvas.text_width(&fonts.value, &shown, theme.m.sub_px) <= max + 1.0);
+            assert!(!shown.is_empty());
+        }
+        assert_eq!(preview(&canvas, &theme, &fonts, "1.1.1.1"), "1.1.1.1");
+    }
+}
