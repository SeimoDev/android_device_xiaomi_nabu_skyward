 //! Making a block device out of part of a file, which is how the bundles a
 //! phone keeps its shared libraries in are opened.
 
+/// Copy a bundle's payload into recovery memory before making a loop device.
+/// The original partition can then be released without leaving a backing file open.
+pub fn copy_backing(file: &std::path::Path, to: &std::path::Path, offset: u64, length: u64) -> anyhow::Result<()> {
+    use anyhow::{Context, ensure};
+    use std::io::{Read, Seek, SeekFrom};
+    ensure!(length > 0, "empty loop backing image");
+    let mut source = std::fs::File::open(file).with_context(|| format!("open {}", file.display()))?;
+    source.seek(SeekFrom::Start(offset)).context("seek to the bundle payload")?;
+    let pending = to.with_extension("part");
+    let copied = (|| -> anyhow::Result<()> {
+        let mut target = std::fs::File::create(&pending).with_context(|| format!("create {}", pending.display()))?;
+        let n = std::io::copy(&mut source.take(length), &mut target).context("copy the bundle payload into recovery memory")?;
+        ensure!(n == length, "bundle payload ended after {n} of {length} bytes");
+        drop(target);
+        std::fs::rename(&pending, to).with_context(|| format!("keep {}", to.display()))?;
+        Ok(())
+    })();
+    if copied.is_err() { let _ = std::fs::remove_file(&pending); }
+    copied
+}
+
