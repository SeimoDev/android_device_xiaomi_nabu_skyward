@@ -0,0 +1,190 @@
+//! Network preferences shared by the Wi-Fi pages and HTTP clients.
+
+use serde::{Deserialize, Serialize};
+use std::net::{IpAddr, Ipv4Addr};
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum ProxyKind {
+    #[default]
+    None,
+    Http,
+    Socks5,
+}
+
+#[derive(Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(default)]
+pub struct Proxy {
+    pub kind: ProxyKind,
+    pub server: String,
+    pub port: u16,
+    pub username: String,
+    pub password: String,
+}
+
+impl Default for Proxy {
+    fn default() -> Self {
+        Self { kind: ProxyKind::None, server: String::new(), port: 8080, username: String::new(), password: String::new() }
+    }
+}
+
+impl std::fmt::Debug for Proxy {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("Proxy")
+            .field("kind", &self.kind)
+            .field("server", &self.server)
+            .field("port", &self.port)
+            .field("username", &self.username)
+            .field("password", &format_args!("{} characters", self.password.chars().count()))
+            .finish()
+    }
+}
+
+#[derive(Clone, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(default)]
+pub struct Dns {
+    pub manual: bool,
+    pub primary: String,
+    pub secondary: String,
+}
+
+#[derive(Clone, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(default)]
+pub struct Settings {
+    pub proxy: Proxy,
+    pub dns: Dns,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Invalid {
+    ProxyServer,
+    ProxyPort,
+    ProxyUsername,
+    DnsPrimary,
+    DnsSecondary,
+}
+
+impl Settings {
+    pub fn validate(&self) -> Result<(), Invalid> {
+        if self.proxy.kind != ProxyKind::None {
+            let host = self.proxy.server.trim();
+            let ip = host.parse::<IpAddr>().is_ok();
+            let name = !host.is_empty()
+                && host.len() <= 253
+                && host.split('.').all(|part| !part.is_empty() && part.len() <= 63
+                    && !part.starts_with('-') && !part.ends_with('-')
+                    && part.bytes().all(|ch| ch.is_ascii_alphanumeric() || ch == b'-'));
+            if !ip && !name {
+                return Err(Invalid::ProxyServer);
+            }
+            if self.proxy.port == 0 {
+                return Err(Invalid::ProxyPort);
+            }
+            if !self.proxy.password.is_empty() && self.proxy.username.is_empty() {
+                return Err(Invalid::ProxyUsername);
+            }
+            if self.proxy.kind == ProxyKind::Socks5 && (self.proxy.username.len() > 255 || self.proxy.password.len() > 255) {
+                return Err(Invalid::ProxyUsername);
+            }
+        }
+        if self.dns.manual {
+            parse_dns(&self.dns.primary).map_err(|_| Invalid::DnsPrimary)?;
+            if !self.dns.secondary.trim().is_empty() {
+                parse_dns(&self.dns.secondary).map_err(|_| Invalid::DnsSecondary)?;
+            }
+        }
+        Ok(())
+    }
+
+    /// The manual servers, or the current DHCP lease's servers.
+    pub fn dns_servers(&self, dhcp: &[Ipv4Addr]) -> Vec<IpAddr> {
+        if !self.dns.manual {
+            return dhcp.iter().copied().map(IpAddr::V4).collect();
+        }
+        [&self.dns.primary, &self.dns.secondary].into_iter().filter_map(|s| parse_dns(s).ok()).collect()
+    }
+
+    pub fn proxy(&self) -> Option<ureq::Proxy> {
+        let protocol = match self.proxy.kind {
+            ProxyKind::None => return None,
+            ProxyKind::Http => ureq::ProxyProtocol::Http,
+            ProxyKind::Socks5 => ureq::ProxyProtocol::Socks5h,
+        };
+        let server = self.proxy.server.trim();
+        let host = if server.contains(':') { format!("[{server}]") } else { server.to_owned() };
+        let mut builder = ureq::Proxy::builder(protocol).host(&host).port(self.proxy.port).resolve_target(false);
+        if !self.proxy.username.is_empty() {
+            builder = builder.username(&self.proxy.username).password(&self.proxy.password);
+        }
+        Some(builder.build().expect("network settings validated before use"))
+    }
+}
+
+pub fn parse_dns(text: &str) -> Result<IpAddr, Invalid> {
+    let address: IpAddr = text.trim().parse().map_err(|_| Invalid::DnsPrimary)?;
+    if address.is_unspecified() || address.is_multicast() || address == IpAddr::V4(Ipv4Addr::BROADCAST) {
+        return Err(Invalid::DnsPrimary);
+    }
+    Ok(address)
+}
+
+/// DHCP updates its own values while manual preferences remain in place.
+#[derive(Clone, Debug, Default)]
+pub struct State {
+    pub dhcp: Vec<Ipv4Addr>,
+    pub settings: Settings,
+}
+
+impl State {
+    pub fn dns_servers(&self) -> Vec<IpAddr> {
+        self.settings.dns_servers(&self.dhcp)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn manual_dns_survives_a_new_lease_and_auto_uses_the_latest_lease() {
+        let mut state = State { dhcp: vec![Ipv4Addr::LOCALHOST], ..State::default() };
+        state.settings.dns = Dns { manual: true, primary: "1.1.1.1".into(), secondary: "2606:4700:4700::1111".into() };
+        assert!(state.settings.validate().is_ok());
+        state.dhcp = vec![Ipv4Addr::new(192, 168, 1, 1)];
+        assert_eq!(state.dns_servers(), ["1.1.1.1".parse::<IpAddr>().unwrap(), "2606:4700:4700::1111".parse().unwrap()]);
+        state.settings.dns.manual = false;
+        assert_eq!(state.dns_servers(), [IpAddr::V4(state.dhcp[0])]);
+    }
+
+    #[test]
+    fn proxy_dns_is_remote_and_credentials_are_encoded_and_redacted() {
+        let mut settings = Settings::default();
+        settings.proxy = Proxy { kind: ProxyKind::Socks5, server: "proxy.example".into(), port: 1080,
+            username: "a@b".into(), password: "p:a@ss".into() };
+        assert!(settings.validate().is_ok());
+        let proxy = settings.proxy().unwrap();
+        assert!(!proxy.resolve_target());
+        assert_eq!(proxy.username(), Some("a@b"));
+        assert_eq!(proxy.password(), Some("p:a@ss"));
+        assert!(!format!("{settings:?}").contains("p:a@ss"));
+        settings.proxy.server = "::1".into();
+        assert!(settings.validate().is_ok());
+        assert_eq!(settings.proxy().unwrap().port(), 1080);
+    }
+
+    #[test]
+    fn invalid_network_addresses_are_rejected() {
+        let mut settings = Settings::default();
+        settings.dns.manual = true;
+        for text in ["", "https://dns.example", "0.0.0.0", "255.255.255.255", "224.0.0.1", "::", "ff02::1"] {
+            settings.dns.primary = text.into();
+            assert_eq!(settings.validate(), Err(Invalid::DnsPrimary), "{text}");
+        }
+        settings.dns.manual = false;
+        settings.proxy.kind = ProxyKind::Http;
+        for text in ["", "http://proxy.example", "proxy.example:8080", "x/y", "bad host", "-bad.example"] {
+            settings.proxy.server = text.into();
+            assert_eq!(settings.validate(), Err(Invalid::ProxyServer), "{text}");
+        }
+    }
+}
