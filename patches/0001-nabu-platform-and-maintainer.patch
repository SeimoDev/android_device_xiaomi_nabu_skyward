diff --git a/crates/skyward/src/browser.rs b/crates/skyward/src/browser.rs
new file mode 100644
index 0000000..cc88ccf
--- /dev/null
+++ b/crates/skyward/src/browser.rs
@@ -0,0 +1,83 @@
+//! WPE's isolated process, input pipe and exported webpage frames.
+use anyhow::{Context, Result, ensure};
+use serde_json::{Value, json};
+use skyward_net::http::Servers;
+use skyward_net::network::ProxyKind;
+use skyward_ui::app::{BrowserCommand, BrowserPixels};
+use std::fs::{self, OpenOptions};
+use std::io::{BufRead, BufReader, Read, Write};
+use std::os::fd::RawFd;
+use std::os::unix::fs::{OpenOptionsExt, PermissionsExt};
+use std::os::unix::process::CommandExt;
+use std::path::Path;
+use std::process::{Child, ChildStdin, Command, Stdio};
+use std::sync::Arc;
+
+pub const RUNNER: &str = "/system/bin/skyward-browser";
+const ROOT: &str = "/data/skyward/browser/root";
+const DOWNLOADS: &str = "/sdcard/Download/Skyward";
+pub enum Event { Message(Value), Frame(Arc<BrowserPixels>), Ended }
+pub struct Browser { child: Child, input: ChildStdin, reader: skyward_sys::worker::Worker<Event> }
+impl Browser {
+    pub fn start(w: u32,h: u32,servers: &Servers) -> Result<Self> {
+        ensure!(Path::new(ROOT).join("opt/wpe/browser").is_file(), "浏览器组件未安装，请安装 skyward-browser-runtime.zip 后重试");
+        fs::create_dir_all(DOWNLOADS).context("create the browser download directory")?;
+        // Only this browser-owned subdirectory is exposed to the engine.
+        let downloads=std::ffi::CString::new(DOWNLOADS)?;
+        ensure!(unsafe {libc::chown(downloads.as_ptr(),65534,1023)}==0, "set browser download ownership");
+        fs::set_permissions(DOWNLOADS,fs::Permissions::from_mode(0o775))?;
+        let state=servers.lock().expect("the network preferences lock");
+        let dns=state.dns_servers();
+        let resolver=dns.iter().map(|ip|format!("nameserver {ip}\n")).collect::<String>();
+        fs::write(Path::new(ROOT).join("etc/resolv.conf"),format!("{resolver}options timeout:2 attempts:2\n"))?;
+        let p=&state.settings.proxy;
+        let host=if p.server.contains(':'){format!("[{}]",p.server)}else{p.server.clone()};
+        let proxy=match p.kind {ProxyKind::None=>String::new(),ProxyKind::Http=>format!("http://{host}:{}",p.port),ProxyKind::Socks5=>format!("socks5://{host}:{}",p.port)};
+        let config=json!({"cmd":"configure","proxy":proxy,"username":p.username,"password":p.password});
+        drop(state);
+        let log=OpenOptions::new().write(true).create(true).truncate(true).mode(0o600).open("/tmp/skyward-browser.log")?;
+        let mut command=Command::new(RUNNER);
+        command.args([ROOT,DOWNLOADS,&w.to_string(),&h.to_string()]).stdin(Stdio::piped()).stdout(Stdio::piped()).stderr(log);
+        unsafe { command.pre_exec(|| { if libc::setpgid(0,0)!=0 {return Err(std::io::Error::last_os_error());} Ok(()) }); }
+        let mut child=command.spawn().context("start WPE WebKit")?;
+        let input=child.stdin.take().context("browser input")?;
+        let output=child.stdout.take().context("browser output")?;
+        let reader=skyward_sys::worker::Worker::start("browser",move |tell| {
+            for line in BufReader::new(output).lines() {
+                let Ok(line)=line else {break};
+                if line.len()>65536 {continue;}
+                let Ok(value)=serde_json::from_str::<Value>(&line) else {continue};
+                if value["event"]=="frame" {
+                    if let Ok(p)=read_frame(&value) {tell.tell(Event::Frame(Arc::new(p)));}
+                } else {tell.tell(Event::Message(value));}
+            }
+            tell.tell(Event::Ended);
+        });
+        let reader=match reader {Ok(reader)=>reader,Err(e)=>{unsafe{libc::kill(-(child.id() as i32),libc::SIGKILL);}let _=child.wait();return Err(e)}};
+        let mut browser=Self{child,input,reader};
+        browser.send_value(&config)?;
+        Ok(browser)
+    }
+    pub fn fd(&self)->RawFd {self.reader.fd()}
+    pub fn events(&self)->Vec<Event> {self.reader.events()}
+    fn send_value(&mut self,value:&impl serde::Serialize)->Result<()> {
+        serde_json::to_writer(&mut self.input,value)?;self.input.write_all(b"\n")?;Ok(())
+    }
+    pub fn send(&mut self,command:&BrowserCommand)->Result<()> {self.send_value(command)}
+}
+impl Drop for Browser {
+    fn drop(&mut self) {
+        unsafe{libc::kill(-(self.child.id() as i32),libc::SIGKILL);}
+        let _=self.child.wait();
+    }
+}
+fn read_frame(v:&Value)->Result<BrowserPixels> {
+    let w=v["w"].as_u64().unwrap_or(0);let h=v["h"].as_u64().unwrap_or(0);let stride=v["stride"].as_u64().unwrap_or(0);
+    ensure!((200..=1600).contains(&w)&&(200..=2560).contains(&h)&&stride>=w*4&&stride<=w*4+256,"invalid browser frame");
+    let mut f=OpenOptions::new().read(true).custom_flags(libc::O_NOFOLLOW|libc::O_NONBLOCK).open(Path::new(ROOT).join("output/view.bgra"))?;
+    ensure!(f.metadata()?.is_file()&&f.metadata()?.len()==stride*h,"incomplete browser frame");
+    let mut bgra=vec![0u8;(stride*h) as usize];f.read_exact(&mut bgra)?;
+    let mut rgba=Vec::with_capacity((w*h*4) as usize);
+    for row in bgra.chunks_exact(stride as usize) {for px in row[..w as usize*4].as_chunks::<4>().0 {rgba.extend_from_slice(&[px[2],px[1],px[0],255]);}}
+    Ok(BrowserPixels{w:w as u32,h:h as u32,rgba})
+}
