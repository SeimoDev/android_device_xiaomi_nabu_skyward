+    /// Scale an RGBA webpage into the panel rectangle, respecting a partial canvas.
+    pub fn image_rgba(&mut self, r: crate::geom::Rect, w: u32, h: u32, pixels: &[u8]) {
+        if w == 0 || h == 0 || pixels.len() != w as usize * h as usize * 4 || r.w <= 0.0 || r.h <= 0.0 { return; }
+        let (y0,y1)=self.rows(r.y.ceil() as i32,(r.y+r.h).ceil() as i32);
+        let (x0,x1)=self.columns(r.x.ceil() as i32,(r.x+r.w).ceil() as i32);
+        for y in y0..y1 {
+            let sy=(((y as f32-r.y)*h as f32/r.h) as u32).min(h-1);
+            for x in x0..x1 {
+                let sx=(((x as f32-r.x)*w as f32/r.w) as u32).min(w-1);
+                let src=((sy*w+sx)*4) as usize;
+                let dst=(((y as u32-self.top)*self.span+x as u32-self.left)*4) as usize;
+                self.data[dst..dst+4].copy_from_slice(&pixels[src..src+4]);
+            }
+        }
+    }
