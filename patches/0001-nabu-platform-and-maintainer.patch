+/// Newer drivers name the panel node directly. SM8150 names a display's
+/// label instead; that display's qcom,dsi-panel phandle selects the panel.
+fn panel_node(soc: &Path, name: &str) -> Result<PathBuf> {
+    let children = |dir: &Path| -> Result<Vec<PathBuf>> {
+        let mut paths = Vec::new();
+        for entry in fs::read_dir(dir).with_context(|| format!("read {}", dir.display()))? {
+            let entry = entry?;
+            if entry.file_type()?.is_dir() {
+                paths.push(entry.path());
+            }
+        }
+        Ok(paths)
+    };
+    let mut nodes = children(soc)?;
+    for parent in nodes.clone() {
+        nodes.extend(children(&parent)?);
+    }
+    if let Some(node) = nodes.iter().find(|p| p.file_name().is_some_and(|n| n == name)) {
+        return Ok(node.clone());
+    }
+    let label = format!("{name}\0").into_bytes();
+    if let Some(display) = nodes.iter().find(|p| fs::read(p.join("label")).ok().as_ref() == Some(&label)) {
+        let handle = fs::read(display.join("qcom,dsi-panel")).context("read display panel phandle")?;
+        ensure!(handle.len() == 4, "display {name}: invalid panel phandle");
+        if let Some(panel) = nodes.iter().find(|p| fs::read(p.join("phandle")).ok().as_ref() == Some(&handle)) {
+            return Ok(panel.clone());
+        }
+    }
+    anyhow::bail!("panel {name} is not in the device tree")
