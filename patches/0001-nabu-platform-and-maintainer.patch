index 0000000..02616d6
--- /dev/null
+++ b/crates/skyward-install/src/boot.rs
@@ -0,0 +1,194 @@
+//! Installing recovery into a boot slot while retaining its kernel and
+//! normal Android boot path. Every write follows a persistent boot backup.
+use anyhow::{ensure, Context, Result};
+use sha2::{Digest, Sha256};
+use skyward_bootimg::{avb, BootImage, Ramdisk};
+use skyward_config::{ramdisk, DeviceConfig};
+use std::fs::{self, OpenOptions};
+use std::io::{Cursor, Read, Write};
+use std::path::{Path, PathBuf};
+
+pub const BACKUPS: &str = "/data/media/0/Skyward/boot-backups";
+
+/// Rebuild a slot's boot from its own header and kernel and the packaged
+/// recovery ramdisk. The package is retained so installation can run again.
+pub fn prepare(stock: &[u8], package: &[u8], capacity: usize, codename: &str) -> Result<Vec<u8>> {
+    prepare_from_root(stock, package, capacity, codename, Path::new("/"))
+}
+
+/// Reconstruct large immutable ramdisk files from the matching running
+/// recovery, checking every size and digest before preparing an image.
+pub fn prepare_from_root(stock: &[u8], package: &[u8], capacity: usize, codename: &str, root: &Path) -> Result<Vec<u8>> {
+    ensure!(capacity == stock.len(), "boot image size differs from partition capacity");
+    let mut image = BootImage::parse(stock)?;
+    ensure!(!image.kernel.is_empty(), "the boot image has no kernel");
+    let mut zip = zip::ZipArchive::new(Cursor::new(package)).context("read the boot installer package")?;
+    let mut payload = Vec::new();
+    zip.by_name("ramdisk.cpio.gz")?.read_to_end(&mut payload)?;
+    let mut expected = Vec::new();
+    zip.by_name("kernel.sha256")?.read_to_end(&mut expected)?;
+    ensure!(Sha256::digest(&image.kernel)[..] == expected, "the installed kernel differs from this device build's supported kernel");
+    let mut rd = Ramdisk::decode(&payload)?;
+    let mut files = String::new();
+    zip.by_name("ramdisk.files")?.read_to_string(&mut files)?;
+    for line in files.lines() {
+        let fields: Vec<&str> = line.split('\t').collect();
+        ensure!(fields.len() == 3, "invalid boot installer file inventory");
+        let (name, size, expected) = (fields[0], fields[1].parse::<usize>()?, fields[2]);
+        ensure!((name.starts_with("system/") || name.starts_with("skyward/")) && Path::new(name).components().all(|p| matches!(p, std::path::Component::Normal(_))), "invalid boot installer file path");
+        let entry = rd.entries.iter_mut().find(|e| e.name == name).context("installer file is absent from the ramdisk")?;
+        ensure!(entry.mode & 0o170000 == 0o100000 && entry.data.is_empty(), "installer file is not an empty regular file");
+        let data = fs::read(root.join(name)).with_context(|| format!("read recovery file {name}"))?;
+        let sum: String = Sha256::digest(&data).iter().map(|b| format!("{b:02x}")).collect();
+        ensure!(data.len() == size && sum == expected, "{name} differs from the matching recovery build; boot has not been written");
+        entry.data = data;
+    }
+    let config = rd.find(ramdisk::CONFIG).context("the recovery ramdisk has no device configuration")?;
+    let cfg = DeviceConfig::parse(std::str::from_utf8(&config.data)?)?;
+    ensure!(cfg.device.codename == codename && cfg.device.recovery_in_boot, "the installer package does not support this device's boot layout");
+    ensure!(rd.find(ramdisk::BOOT_INSTALLER).is_none(), "the installer payload contains a nested installer");
+    rd.add(ramdisk::BOOT_INSTALLER, 0o644, package.to_vec())?;
+    image.ramdisk = rd.encode_like(&payload)?;
+    // The temporary fastboot image forces recovery. Installed boot follows
+    // the bootloader's normal/recovery choice through the base's init.
+    let commandline = std::str::from_utf8(&image.header.cmdline[..])?.trim_end_matches('\0');
+    let commandline = commandline.split_whitespace().filter(|word| {
+        !matches!(word.split('=').next(), Some("twrpfastboot" | "androidboot.fastboot"))
+    }).collect::<Vec<_>>().join(" ");
+    image.header.cmdline.fill(0);
+    image.header.cmdline[..commandline.len()].copy_from_slice(commandline.as_bytes());
+    let bytes = image.to_bytes()?;
+    avb::footed(&bytes, "boot", capacity, &Sha256::digest(&bytes))
+}
+
+/// Save the entire partition before any flash. An existing matching
+/// backup is reused only after its complete contents have been verified.
+pub fn backup(original: &[u8], directory: &Path, name: &str) -> Result<PathBuf> {
+    ensure!(matches!(name, "boot_a" | "boot_b"), "unexpected boot partition name");
+    fs::create_dir_all(directory)?;
+    let digest = Sha256::digest(original);
+    let sum: String = digest.iter().map(|byte| format!("{byte:02x}")).collect();
+    let path = directory.join(format!("{name}-{sum}.img"));
+    match OpenOptions::new().write(true).create_new(true).open(&path) {
+        Ok(mut file) => {
+            file.write_all(original)?;
+            file.sync_all()?;
+            std::fs::File::open(directory)?.sync_all()?;
+        }
+        Err(e) if e.kind() == std::io::ErrorKind::AlreadyExists => {}
+        Err(e) => return Err(e).context("create the original boot backup"),
+    }
+    ensure!(fs::read(&path)? == original, "the original boot backup failed verification");
+    Ok(path)
+}
+
+#[cfg(target_os = "android")]
+pub fn install_running(package: &Path) -> Result<()> {
+    let cfg = DeviceConfig::load(Path::new("/").join(ramdisk::CONFIG))?;
+    ensure!(cfg.device.codename == "nabu" && cfg.device.recovery_in_boot, "this build does not support boot installation");
+    ensure!(skyward_block::boot_param("androidboot.verifiedbootstate")?.as_deref() == Some("orange"), "boot installation requires an unlocked bootloader");
+    ensure!(skyward_vab::snapshot_state()? == skyward_vab::SnapshotState::None, "finish the pending system update before installing to boot");
+    ensure!(skyward_block::mount::is_mount_point(Path::new("/data"))? && Path::new("/data/media/0").is_dir(), "open internal storage before installing to boot");
+    let slot = skyward_vab::current_slot()?.context("the current boot slot is unknown")?;
+    let name = format!("boot{}", slot.suffix());
+    let device = crate::image::device(Path::new(skyward_block::BY_NAME), "boot", slot);
+    let capacity = usize::try_from(skyward_block::size_bytes(&device)?)?;
+    ensure!(capacity == 134217728, "unexpected nabu boot partition size");
+    let original = fs::read(&device)?;
+    println!("Preparing {name}; preserving the installed kernel");
+    let image = prepare(&original, &fs::read(package)?, capacity, &cfg.device.codename)?;
+    let saved = backup(&original, Path::new(BACKUPS), &name)?;
+    println!("Original boot backup: {}", saved.display());
+    ensure!(fs::read(&device)? == original, "boot changed while the installer was preparing");
+    println!("Writing and verifying {name}");
+    crate::image::flash(&mut Cursor::new(&image), image.len() as u64, &[device], &mut |_, _| {})?;
+    println!("Skyward is installed in {name}. Reboot to system or recovery.");
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn sample(codename: &str) -> (Vec<u8>, Vec<u8>) {
+        let mut rd = Ramdisk::decode(&crate::image::samples::lz4_legacy(&crate::image::samples::archive(&[]))).unwrap();
+        rd.add(ramdisk::CONFIG, 0o644, format!("[device]\ncodename = \"{codename}\"\nrecovery_in_boot = true\n").into_bytes()).unwrap();
+        let payload = rd.encode_like(&[0x1f, 0x8b]).unwrap();
+        let mut image = BootImage::parse(&crate::image::samples::boot_image(64, &payload)).unwrap();
+        let args = b"console=ttyMSM0 twrpfastboot=1 androidboot.fastboot=1 androidboot.hardware=qcom";
+        image.header.cmdline[..args.len()].copy_from_slice(args);
+        let mut stock = image.to_bytes().unwrap();
+        stock.resize(65536, 0);
+        let mut zip = zip::ZipWriter::new(Cursor::new(Vec::new()));
+        let options = zip::write::SimpleFileOptions::default();
+        for (name, data) in [("ramdisk.cpio.gz", payload), ("ramdisk.files", Vec::new()), ("kernel.sha256", Sha256::digest(&image.kernel).to_vec())] {
+            zip.start_file(name, options).unwrap();
+            zip.write_all(&data).unwrap();
+        }
+        (stock, zip.finish().unwrap().into_inner())
+    }
+
+    #[test]
+    fn boot_preparation_keeps_the_kernel_and_normal_boot_path_and_rebuilds_avb() {
+        let (stock, package) = sample("nabu");
+        let result = prepare(&stock, &package, stock.len(), "nabu").unwrap();
+        let before = BootImage::parse(&stock).unwrap();
+        let after = BootImage::parse(&result).unwrap();
+        assert_eq!(after.kernel, before.kernel);
+        let cmdline = std::str::from_utf8(&after.header.cmdline[..]).unwrap().trim_end_matches('\0');
+        assert_eq!(cmdline, "console=ttyMSM0 androidboot.hardware=qcom");
+        let rd = Ramdisk::decode(&after.ramdisk).unwrap();
+        assert_eq!(rd.find(ramdisk::BOOT_INSTALLER).unwrap().data, package);
+        assert_eq!(result.len(), stock.len());
+        assert_eq!(&result[result.len()-64..result.len()-60], b"AVBf");
+        let footer = &result[result.len()-64..];
+        let vbmeta = u64::from_be_bytes(footer[20..28].try_into().unwrap()) as usize;
+        assert!(result[vbmeta..].windows(4).any(|w| w == b"boot"));
+    }
+
+    #[test]
+    fn mismatched_device_kernel_or_capacity_is_refused_before_writing() {
+        let (mut stock, package) = sample("nabu");
+        assert!(prepare(&stock, &package, stock.len(), "ishtar").is_err());
+        assert!(prepare(&stock, &package, stock.len()-4096, "nabu").is_err());
+        stock[4096] ^= 1;
+        assert!(prepare(&stock, &package, stock.len(), "nabu").is_err());
+    }
+
+    #[test]
+    fn runtime_files_are_restored_only_when_their_digests_match() {
+        let (stock, package) = sample("nabu");
+        let mut old = zip::ZipArchive::new(Cursor::new(&package)).unwrap();
+        let mut payload = Vec::new();
+        old.by_name("ramdisk.cpio.gz").unwrap().read_to_end(&mut payload).unwrap();
+        let mut rd = Ramdisk::decode(&payload).unwrap();
+        rd.add("system/bin/runtime-file", 0o755, Vec::new()).unwrap();
+        let data = vec![7; 65536];
+        let sum: String = Sha256::digest(&data).iter().map(|b| format!("{b:02x}")).collect();
+        let files = format!("system/bin/runtime-file\t65536\t{sum}\n");
+        let mut zip = zip::ZipWriter::new(Cursor::new(Vec::new()));
+        for (name, value) in [("ramdisk.cpio.gz", rd.encode_like(&payload).unwrap()), ("ramdisk.files", files.into_bytes()), ("kernel.sha256", Sha256::digest(&BootImage::parse(&stock).unwrap().kernel).to_vec())] {
+            zip.start_file(name, zip::write::SimpleFileOptions::default()).unwrap();
+            zip.write_all(&value).unwrap();
+        }
+        let package = zip.finish().unwrap().into_inner();
+        let root = tempfile::tempdir().unwrap();
+        let dir = root.path().join("system/bin");
+        fs::create_dir_all(&dir).unwrap();
+        fs::write(dir.join("runtime-file"), data).unwrap();
+        let image = prepare_from_root(&stock, &package, stock.len(), "nabu", root.path()).unwrap();
+        let rd = Ramdisk::decode(&BootImage::parse(&image).unwrap().ramdisk).unwrap();
+        assert_eq!(rd.find("system/bin/runtime-file").unwrap().data.len(), 65536);
+        fs::write(dir.join("runtime-file"), vec![8;65536]).unwrap();
+        assert!(prepare_from_root(&stock, &package, stock.len(), "nabu", root.path()).is_err());
+    }
+
+    #[test]
+    fn backup_keeps_the_original_and_rejects_a_damaged_previous_copy() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = backup(b"original boot", dir.path(), "boot_a").unwrap();
+        assert_eq!(backup(b"original boot", dir.path(), "boot_a").unwrap(), path);
+        fs::write(&path, b"truncated").unwrap();
+        assert!(backup(b"original boot", dir.path(), "boot_a").is_err());
+        assert!(backup(b"original boot", dir.path(), "../boot").is_err());
+    }
+}
